# ---- AquaGuard / AlertaCidadão - variáveis de ambiente (copie para .env) ----
# Clima real: crie uma chave gratuita em https://home.openweathermap.org/api_keys
# Sem chave (ou com falha de rede) => o backend usa clima MOCKADO automaticamente
OPENWEATHER_API_KEY=
CITY_LAT=-23.5505
CITY_LON=-46.6333
CITY_NAME=São Paulo
WEATHER_TIMEOUT_S=5
WEATHER_CACHE_TTL_S=600
# Opcional: LLM para redação das respostas. Sem chave => respostas extrativas (100% grounded)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Segundos sem telemetria real até considerar o ESP32 offline
TELEMETRY_TIMEOUT_S=60
# Sal para pseudonimização (troque em produção)
PRIVACY_SALT=troque-este-sal
# Token simples para o ESP32 / simulador (header X-Device-Token)
DEVICE_TOKEN=fiap-gs-2026
# Disparo automático (simulado) de alertas aos contatos quando o risco vira VERMELHO
AUTO_DISPATCH_ON_RED=true
# ── IoT (MQTT — mesmo broker/tópico do firmware em src/iot/firmware/aquaguard_esp32) ──
# Sem MQTT_SERVER => o listener fica desligado (use o simulador HTTP normalmente)
MQTT_SERVER=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=esp32/aquaguard/data
